    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/parser": "^7.3.1",
    "dayjs": "^1.11.5",
    "eslint": "^8.57.0",
    "eslint-plugin-file-extension-in-import-ts": "^2.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^0.8.0",
